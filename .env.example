# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
SESSION_COOKIE_NAME=absensi_session
SESSION_TTL_HOURS=24

# PostgreSQL
POSTGRES_DB=absensi
POSTGRES_USER=absensi
POSTGRES_PASSWORD=change-me-local-only

DATABASE_URL=postgresql://absensi:change-me-local-only@localhost:5432/absensi?schema=public

# Email notifications / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=
SMTP_PASSWORD=

MAIL_FROM_NAME=Sistem Absensi
MAIL_FROM_EMAIL=

# Initial admin seed (change before production)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# Local photo storage
ATTENDANCE_STORAGE_PATH=./storage/attendance
MAX_ATTENDANCE_IMAGE_BYTES=5242880

# Office GPS / geofence

# Reverse geocoding
GEOAPIFY_API_KEY=

# OFFICE check-in must be within the configured office radius.
MAX_OFFICE_GPS_ACCURACY_METERS=500

# Jakarta
OFFICE_JAKARTA_LATITUDE=
OFFICE_JAKARTA_LONGITUDE=

# Bandung
OFFICE_BANDUNG_LATITUDE=
OFFICE_BANDUNG_LONGITUDE=

# Yogyakarta
OFFICE_JOGJA_LATITUDE=
OFFICE_JOGJA_LONGITUDE=

# Surabaya
OFFICE_SURABAYA_LATITUDE=
OFFICE_SURABAYA_LONGITUDE=

# Cloudflare Quick Tunnel: no token/domain required.
# URL is generated at runtime and may change after tunnel restart.
