# Application
NODE_ENV=development
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Jakarta
SESSION_COOKIE_NAME=absensi_session
SESSION_TTL_HOURS=24

# PostgreSQL
POSTGRES_DB=absensi
POSTGRES_USER=absensi
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://absensi:change-me-local-only@postgres:5432/absensi?schema=public

# Initial admin seed (change before production)
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Administrator

# Local photo storage
ATTENDANCE_STORAGE_PATH=/app/storage/attendance
MAX_ATTENDANCE_IMAGE_BYTES=5242880

# Cloudflare Quick Tunnel: no token/domain required.
# URL is generated at runtime and may change after tunnel restart.
