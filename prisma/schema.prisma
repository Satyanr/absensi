generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYEE
  OFFICER
  LEADER
  ADMIN
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceSource {
  WEB_CAMERA
  WEB_FILE_CAPTURE
  ADMIN
  LEGACY_IMPORT
}

enum AttendanceDayStatus {
  PRESENT
  LEAVE
  SICK
  PERMISSION
  ABSENT
  HOLIDAY
}

enum CheckInStatus {
  ON_TIME
  LATE
  OVERTIME
  LEGACY
}

enum CheckOutStatus {
  NORMAL
  EARLY_LEAVE
  OVERTIME
  LEGACY
}

enum LeaveType {
  PERMISSION
  SICK
  ANNUAL_LEAVE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOGIN
  LOGOUT
  IMPORT
  RESTORE
}

enum AttendanceMode {
  OFFICE
  PROJECT
}

model Employee {
  id            String    @id @default(cuid())
  employeeCode  String    @unique @map("employee_code")
  name          String
  email         String?   @unique
  phone         String?
  joinDate      DateTime? @map("join_date") @db.Date
  leaveEligible Boolean   @default(true) @map("leave_eligible")
  active        Boolean   @default(true)
  legacyId      BigInt?   @unique @map("legacy_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  users            User[]
  attendanceDays   AttendanceDay[]
  attendanceEvents AttendanceEvent[]
  leaveRequests    LeaveRequest[]
  leaveBalances    LeaveBalance[]

  @@map("employees")
}

model User {
  id           String   @id @default(cuid())
  employeeId   String?  @map("employee_id")
  email        String?  @unique
  username     String?  @unique
  passwordHash String?  @map("password_hash")
  pinHash      String?  @map("pin_hash")
  role         UserRole @default(EMPLOYEE)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee       Employee?      @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  sessions       Session[]
  approvedLeaves LeaveRequest[] @relation("LeaveApprover")
  auditLogs      AuditLog[]     @relation("AuditActor")

  @@index([employeeId])
  @@map("users")
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AttendancePolicy {
  id                String    @id @default(cuid())
  name              String
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveUntil    DateTime? @map("effective_until") @db.Date
  workStart         String    @map("work_start")
  lateAfter         String    @map("late_after")
  workEnd           String    @map("work_end")
  overtimeAfter     String    @map("overtime_after")
  timezone          String    @default("Asia/Jakarta")
  weekendIsOvertime Boolean   @default(true) @map("weekend_is_overtime")
  saturdayWorking   Boolean   @default(false) @map("saturday_working")
  sundayWorking     Boolean   @default(false) @map("sunday_working")
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([effectiveFrom, effectiveUntil])
  @@map("attendance_policies")
}

model AttendanceLocation {
  id           String   @id @default(cuid())
  name         String
  latitude     Decimal  @db.Decimal(10, 7)
  longitude    Decimal  @db.Decimal(10, 7)
  radiusMeters Int      @map("radius_meters")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("attendance_locations")
}

model AttendanceDay {
  id                String              @id @default(cuid())
  employeeId        String              @map("employee_id")
  attendanceDate    DateTime            @map("attendance_date") @db.Date
  attendanceMode    AttendanceMode      @default(OFFICE) @map("attendance_mode")
  checkInAt         DateTime?           @map("check_in_at")
  checkOutAt        DateTime?           @map("check_out_at")
  checkInStatus     CheckInStatus?      @map("check_in_status")
  checkOutStatus    CheckOutStatus?     @map("check_out_status")
  lateMinutes       Int                 @default(0) @map("late_minutes")
  earlyLeaveMinutes Int                 @default(0) @map("early_leave_minutes")
  overtimeMinutes   Int                 @default(0) @map("overtime_minutes")
  status            AttendanceDayStatus @default(PRESENT)
  notes             String?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  events   AttendanceEvent[]

  @@unique([employeeId, attendanceDate])
  @@index([attendanceDate])
  @@map("attendance_days")
}

model AttendanceEvent {
  id                 String              @id @default(cuid())
  attendanceDayId    String              @map("attendance_day_id")
  employeeId         String              @map("employee_id")
  attendanceMode     AttendanceMode      @default(OFFICE) @map("attendance_mode")
  eventType          AttendanceEventType @map("event_type")
  clientCapturedAt   DateTime?           @map("client_captured_at")
  serverReceivedAt   DateTime            @default(now()) @map("server_received_at")
  latitude           Decimal?            @db.Decimal(10, 7)
  longitude          Decimal?            @db.Decimal(10, 7)
  locationAccuracy   Decimal?            @map("location_accuracy") @db.Decimal(10, 2)
  locationCapturedAt DateTime?           @map("location_captured_at")
  address            String?
  photoId            String?             @map("photo_id")
  source             AttendanceSource
  deviceInfo         Json?               @map("device_info")
  outsideGeofence    Boolean?            @map("outside_geofence")
  distanceMeters     Decimal?            @map("distance_meters") @db.Decimal(10, 2)
  legacyAbsensiId    BigInt?             @unique @map("legacy_absensi_id")
  createdAt          DateTime            @default(now()) @map("created_at")

  attendanceDay AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  photo         Attachment?   @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@unique([attendanceDayId, eventType])
  @@index([employeeId, serverReceivedAt])
  @@index([attendanceDayId, eventType])
  @@map("attendance_events")
}

model Attachment {
  id               String   @id @default(cuid())
  storageDisk      String   @default("local") @map("storage_disk")
  storagePath      String   @unique @map("storage_path")
  originalFilename String?  @map("original_filename")
  mimeType         String   @map("mime_type")
  fileSize         BigInt   @map("file_size")
  checksum         String
  legacyFilename   String?  @unique @map("legacy_filename")
  createdAt        DateTime @default(now()) @map("created_at")

  attendanceEvents       AttendanceEvent[]
  leaveRequests          LeaveRequest[]    @relation("LeaveAttachment")
  approvedLeaveDocuments LeaveRequest[]    @relation("LeaveApprovedDocument")

  @@map("attachments")
}

model LeaveRequest {
  id                 String             @id @default(cuid())
  employeeId         String             @map("employee_id")
  type               LeaveType
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime           @map("end_date") @db.Date
  reason             String
  status             LeaveRequestStatus @default(PENDING)
  attachmentId       String?            @map("attachment_id")
  approvedDocumentId String?            @map("approved_document_id")
  submittedAt        DateTime           @default(now()) @map("submitted_at")
  approvedAt         DateTime?          @map("approved_at")
  approvedBy         String?            @map("approved_by")
  legacyApprovalId   BigInt?            @unique @map("legacy_approval_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  attachment       Attachment? @relation("LeaveAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)
  approvedDocument Attachment? @relation("LeaveApprovedDocument", fields: [approvedDocumentId], references: [id], onDelete: SetNull)
  approver         User?       @relation("LeaveApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([approvedDocumentId])
  @@index([employeeId, startDate, endDate])
  @@index([status])
  @@map("leave_requests")
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String   @map("employee_id")
  year        Int
  entitlement Int      @default(0)
  carriedOver Int      @default(0) @map("carried_over")
  used        Int      @default(0)
  adjusted    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("leave_balances")
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?     @map("actor_id")
  action     AuditAction
  entityType String      @map("entity_type")
  entityId   String?     @map("entity_id")
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}
